<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.sonsure</groupId>
    <artifactId>synclavis4j</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>synclavis4j</name>
    <description>synclavis Java backend (JDK 8 + Spring Boot 2.7.18 + JGit 5.13)</description>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JGit 5.x 为 JDK 8 可用的最后一个大版本 -->
        <jgit.version>5.13.0.202109080827-r</jgit.version>
    </properties>

    <repositories>
        <!--
          pty4j 的 jtermios 依赖（JetBrains 维护的 purejavacomm）未发布到 Maven Central，
          官方坐标只在该仓库提供；它是 pty4j 运行必需项。
        -->
        <repository>
            <id>jetbrains-intellij-dependencies</id>
            <url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Git 操作：纯 Java 实现，不依赖系统 git 命令 -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>${jgit.version}</version>
        </dependency>
        <!-- SSH 认证（Apache MINA SSHD），必须显式引入 -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit.ssh.apache</artifactId>
            <version>${jgit.version}</version>
        </dependency>

        <!--
          交互式终端 PTY。0.12.10-jdk8 是最后一个 Java 8 字节码版本；
          0.12.12+ 均为 Java 11（class version 55），不能升级。
          其 jtermios 依赖来自 JetBrains 仓库（见上方 repositories），
          且必须使用 JetBrains 维护的版本：Central 上的 purejavacomm 1.0.2
          仍调用 JNA 4 的 Native.setPreserveLastError，与 JNA 5 不兼容。
        -->
        <dependency>
            <groupId>org.jetbrains.pty4j</groupId>
            <artifactId>pty4j</artifactId>
            <version>0.12.10-jdk8</version>
        </dependency>
        <!-- pty4j 的 JNA 传递版本需要显式锁定；5.12.1 支持 macOS arm64 -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.12.1</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.12.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- 产出 META-INF/build-info.properties（version 取 pom 的 <version>），
                         HealthController 由此读版本，不再硬编码一份 -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JDK 8 API 兜底：拦截 Java 9+ API 误用 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
                <version>1.23</version>
                <configuration>
                    <signature>
                        <groupId>org.codehaus.mojo.signature</groupId>
                        <artifactId>java18</artifactId>
                        <version>1.0</version>
                    </signature>
                </configuration>
                <executions>
                    <execution>
                        <id>check-java8-api</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          前端整包：mvn clean package -Pfrontend
          先构建 synclavis-front（pnpm install + pnpm build，build 内含 vue-tsc 类型检查），
          再把 dist 拷进 target/classes/static，产出的 jar 可直接 java -jar 启动。
          默认不激活，纯后端命令（如 JDK8 校验 mvn verify）无需本机安装 Node/pnpm。
        -->
        <profile>
            <id>frontend</id>
            <properties>
                <frontend.dir>${project.basedir}/../synclavis-front</frontend.dir>
            </properties>
            <build>
                <plugins>
                    <!-- 前端构建必须先于拷贝执行，故声明在 maven-resources-plugin 之前 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>pnpm-install</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>pnpm</executable>
                                    <workingDirectory>${frontend.dir}</workingDirectory>
                                    <arguments>
                                        <argument>install</argument>
                                        <argument>--frozen-lockfile</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pnpm-build</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>pnpm</executable>
                                    <workingDirectory>${frontend.dir}</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 把前端产物拷进 static，随 jar 一起打包 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-frontend-dist</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${frontend.dir}/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
